# Database
DB_PORT=3306
DB_NAME=wiki
DB_USER=wikiuser
DB_PASSWORD=change_me

# Wiki location
WIKI_PORT=8080

# Admin credentials
ADMIN_USER=admin
ADMIN_PASS=adminpassword

# Secrets
MEDIAWIKI_SECRET=change_me

# Optional override for $wgCanonicalServer
CANONICAL_URL=

# hCaptcha keys
CAPTCHA_USE_HCAPTCHA=false
CAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
CAPTCHA_SECRETKEY=0x0000000000000000000000000000000000000000

# Discord message webhook
DISCORD_HOOK=change_me

# 64-char hex secret for OATHAuth (2FA). Do not change!
OATHAUTH_SECRET_KEY=change_me

# Cloudflare cache purging
CLOUDFLARE_PURGE_ZONE_ID=change_me
CLOUDFLARE_PURGE_TOKEN=change_me
